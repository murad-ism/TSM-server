{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/myapp.json",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "flushToDiskInterval": "00:00:01"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "TradingDataDbConnection": "Data Source=localhost;Initial Catalog=TradingData;Integrated Security=True;TrustServerCertificate=True;Connection Timeout=60;",
    "UsersDbConection": "Server=localhost;Port=5432;User ID=postgres;Password=postgres;Database=TsmUsers;Pooling=true",
    "TradingLogRecordsDbConection": "mongodb://localhost:27017/TradingSystemLog"
  },
  "Identity": {
    // Is not safe, for tests only
    "TokenKey": "5ppIq5NQA9o44L017X6QVZRYsl3aqd1Zw6cOB6cMJCDrUuqe72IFHxVgpC2Wiqdp"
  },
  "AllowedHosts": "*",
  "MsgQueueSubscriber": {
    "Url": "tcp://127.0.0.1:5556",
    "Channel": "tradingDataChannel"
  }
}